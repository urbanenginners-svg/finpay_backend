NODE_ENV=development
MONGO_CONNECTION_STRING=mongodb://localhost:27017/school-erp
JWT_SECRET=your_jwt_secret
SENTRY_DSN=your_sentry_dsn
MASTER_KEY=your_master_key

# Optional — Twilio SMS (OTP). Preferred when TWILIO_ACTIVE_MODE=true.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+14155552671
# TWILIO_ACTIVE_MODE=false

# Comma-separated advisor mobile numbers for Service Enquiry Hub alerts (optional).
# ENQUIRY_ADVISOR_PHONES=9876543210,9123456789

# Admin email for new service enquiry notifications (defaults to admin@yopmail.com).
# ENQUIRY_ADMIN_EMAIL=admin@yopmail.com

# Hostinger SMTP — enquiry confirmation emails. When SMTP_ACTIVE_MODE is not "true", sends are skipped.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_email_password
# SMTP_FROM=FinPay <noreply@yourdomain.com>
# SMTP_ACTIVE_MODE=false

# QueueBuster — third-party routes use QUEBUSTER_URL; set QUEBUSTER_PARTNER_URL only if token host differs.
# QUEBUSTER_PARTNER_URL=https://api.queuebuster.co/API/public/v1
QUEBUSTER_URL=https://api.queuebuster.co/API/public/v1
QUEBUSTER_CLIENT_ID=
QUEBUSTER_CLIENT_SECRET=
# Chain id for `thirdparty/{chainId}/fetchProducts` (e.g. 82586). QUEBUSTER_CHAIN_ID is preferred; otherwise QUEBUSTER_THIRD_PARTY_CHAIN_ID.
QUEBUSTER_CHAIN_ID=82586
# QUEBUSTER_THIRD_PARTY_CHAIN_ID=

# Prithvi Exchange — remittance / FX rates. When PRITHVI_ACTIVE_MODE is not "true", rate calls return dry-run data.
# PRITHVI_BASE_URL=http://lead-stage-api.ap-south-1.elasticbeanstalk.com/api
# PRITHVI_CLIENT_ID=
# PRITHVI_CLIENT_SECRET=
# PRITHVI_AGENT_ID=
# PRITHVI_SCOPE=read write
# PRITHVI_ACTIVE_MODE=false

# Prithvi Lead System — PAN / passport verification (separate from remittance rates).
# PRITHVI_LEAD_SYSTEM_BASE_URL=http://leadsystem-dev-api.ap-south-1.elasticbeanstalk.com/api
# PRITHVI_LEAD_SYSTEM_CLIENT_ID=
# PRITHVI_LEAD_SYSTEM_CLIENT_SECRET=
# PRITHVI_LEAD_SYSTEM_SCOPE=read write
# PRITHVI_LEAD_SYSTEM_ACTIVE_MODE=false

